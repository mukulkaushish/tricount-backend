							"raw": "{\n  \"code\": \"123456\"\n}"
						},
						"url": { "raw": "{{baseUrl}}/v1/auth/phone/confirm-verification", "host": ["{{baseUrl}}"], "path": ["v1", "auth", "phone", "confirm-verification"] }
					}
				},
				{
					"name": "Remove Phone Number",
					"request": {
						"method": "POST",
						"url": { "raw": "{{baseUrl}}/v1/auth/phone/remove", "host": ["{{baseUrl}}"], "path": ["v1", "auth", "phone", "remove"] }
					}
