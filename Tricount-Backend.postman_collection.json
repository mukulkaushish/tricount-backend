							"raw": "{\n  \"code\": \"123456\"\n}"
						},
						"url": { "raw": "{{baseUrl}}/v1/auth/mfa/email/confirm-enable", "host": ["{{baseUrl}}"], "path": ["v1", "auth", "mfa", "email", "confirm-enable"] }
