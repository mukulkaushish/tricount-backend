			]
		},
		{
			"name": "Passkeys (Protected)",
			"item": [
				{
					"name": "List Passkeys",
					"request": {
						"method": "GET",
						"url": { "raw": "{{baseUrl}}/v1/auth/passkeys", "host": ["{{baseUrl}}"], "path": ["v1", "auth", "passkeys"] }
					}
				},
				{
					"name": "Begin Passkey Registration",
					"request": {
						"method": "POST",
						"url": { "raw": "{{baseUrl}}/v1/auth/passkeys/register/options", "host": ["{{baseUrl}}"], "path": ["v1", "auth", "passkeys", "register", "options"] }
					}
				},
				{
					"name": "Finish Passkey Registration",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"id\": \"credential-id\",\n  \"rawId\": \"base64url-raw-id\",\n  \"type\": \"public-key\",\n  \"response\": {\n    \"clientDataJSON\": \"base64url-encoded\",\n    \"attestationObject\": \"base64url-encoded\",\n    \"transports\": [\"internal\"]\n  }\n}"
						},
						"url": { "raw": "{{baseUrl}}/v1/auth/passkeys/register/verify", "host": ["{{baseUrl}}"], "path": ["v1", "auth", "passkeys", "register", "verify"] }
					}
				},
				{
					"name": "Remove Passkey",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"credentialId\": \"credential-id-here\"\n}"
						},
						"url": { "raw": "{{baseUrl}}/v1/auth/passkeys/remove", "host": ["{{baseUrl}}"], "path": ["v1", "auth", "passkeys", "remove"] }
					}
				},
				{
					"name": "Reset All Passkeys",
					"request": {
						"method": "POST",
						"url": { "raw": "{{baseUrl}}/v1/auth/passkeys/reset", "host": ["{{baseUrl}}"], "path": ["v1", "auth", "passkeys", "reset"] }
					}
				}
			]
		}
	]
}
