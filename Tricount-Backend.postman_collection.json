							"mode": "raw",
							"raw": "{\n  \"code\": \"123456\"\n}"
						},
						"url": { "raw": "{{baseUrl}}/v1/auth/verify-profile/email/confirm", "host": ["{{baseUrl}}"], "path": ["v1", "auth", "verify-profile", "email", "confirm"] }
					}
				}
			]
		},
		{
