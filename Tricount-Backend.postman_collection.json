					}
				}
			]
		},
		{
			"name": "Phone Verification",
			"item": [
				{
					"name": "Request Phone Verification",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"phoneNumber\": \"+1234567890\"\n}"
						},
						"url": { "raw": "{{baseUrl}}/v1/auth/phone/request-verification", "host": ["{{baseUrl}}"], "path": ["v1", "auth", "phone", "request-verification"] }
					}
				},
				{
					"name": "Confirm Phone Verification",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
